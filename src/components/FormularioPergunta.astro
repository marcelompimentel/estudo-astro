---
import { obterOlhar } from '../lib/olhares'
interface Props {
    olharCodigo: string
}

const { olharCodigo } = Astro.props

const olhar = await obterOlhar(olharCodigo)
const olharId = olhar.id
---

<form id="pergunta-form" data-olhar-codigo={olharCodigo} data-olhar-id={olharId} novalidate>
    <div>
        <label for="pergunta">Sua questão</label>
        <textarea
            id="pergunta"
            name="pergunta"
            rows="6"
            minlength="10"
            maxlength="1000"
            placeholder="Escreva aqui sua questão..."
            required
        ></textarea>

        <small id="contador">0 / 1000</small>
    </div>

    <button type="submit" id="submit-button">Enviar questão</button>

    <p id="mensagem" role="status" aria-live="polite" hidden></p>
</form>

<script>
    import { supabase } from "../lib/supabase"

    const form = document.querySelector<HTMLFormElement>('#pergunta-form')
    const textarea = document.querySelector<HTMLTextAreaElement>('#pergunta')
    const button  = document.querySelector<HTMLButtonElement>('#submit-button')
    const mensagem = document.querySelector<HTMLParagraphElement>('#mensagem')
    const contador = document.querySelector<HTMLElement>('#contador')

    if(form && textarea && button && mensagem && contador) {
        const olharId = Number(form.dataset.olharId)

        const atualizarContador = () => {
            contador.textContent = `${textarea.value.length} / 1000`
        }

        const mostrarMensagem = (texto: string, tipo: 'sucesso' | 'erro') => {
            mensagem.textContent = texto
            mensagem.hidden = false
            mensagem.dataset.tipo = tipo
        }

        textarea.addEventListener('input', atualizarContador)

        form.addEventListener('submit', async (event) => {
            event.preventDefault()

            const descricao = textarea.value.trim()

            if (!Number.isInteger(olharId) || olharId <= 0) {
                console.error('olharId inválido:', form.dataset.olharId)
                mostrarMensagem('Não foi possível identificar a seção', 'erro')
                return
            }

            if (descricao.length < 10) {
                mostrarMensagem('Escreva uma questão com pelo menos 10 caracteres', 'erro')
                textarea.focus()
                return
            }

            if (descricao.length > 1000) {
                mostrarMensagem('A questão deve ter no máximo 1000 caracteres.', 'erro')
                textarea.focus()
                return
            }

            button.disabled = true
            button.textContent = 'Enviando...'
            mensagem.hidden = true

            try {
                const { error } = await supabase
                    .from('pergunta')
                    .insert({
                        olhar_id: olharId,
                        descricao
                    })

                if (error) {
                    console.error(error)
                    throw new Error(
                        'Não foi possível enviar sua questão.'
                    )
                }

                textarea.value = ''
                atualizarContador()
                mostrarMensagem('Sua questão foi enviada e será avaliada', 'sucesso')
            }
            catch(error) {
                console.error(error)
                mostrarMensagem('Ocorreu um erro ao enviar sua questão', 'erro')
            }
            finally {
                button.disabled = false
                button.textContent = 'Enviar questão'
            }
        })

        atualizarContador()
    }
</script>